// Dev and test configuration for the bundled Worker. The app generates the production
// wrangler.json itself (see Ketto/Share/ShareBackendSetup.swift); keep the binding name and
// compatibility date here in step with it.
{
  "name": "ketto-share",
  "main": "../Ketto/Resources/CloudflareBackend/worker.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "vars": { "BUCKET_NAME": "ketto-videos-dev" },
  "r2_buckets": [{ "binding": "VIDEOS", "bucket_name": "ketto-videos-dev" }]
}
